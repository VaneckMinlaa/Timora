# ====================================
# Configuration PostgreSQL
# ====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=timora
POSTGRES_PORT=5432

# ====================================
# Configuration RabbitMQ
# ====================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ====================================
# Configuration Eureka
# ====================================
EUREKA_SERVER_URL=http://eureka-server:8761/eureka

# ====================================
# Configuration Config Server
# ====================================
CONFIG_SERVER_GIT_URI=https://github.com/VaneckMinlaa/Timora.git

# ====================================
# Configuration Email (Notification Service)
# ====================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=timora.iusjc@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ====================================
# Configuration SMS Gateway (Optionnel)
# ====================================
SMS_GATEWAY_URL=http://localhost:8089
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_ENABLED=false

# ====================================
# Configuration Frontend
# ====================================
FRONTEND_PORT=80

# ====================================
# Profil Spring
# ====================================
SPRING_PROFILES_ACTIVE=docker

