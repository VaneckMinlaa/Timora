# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copier les fichiers de dépendance
COPY frontend/package*.json ./

# Installer les dépendances
RUN npm ci

# Copier le code source
COPY frontend/ .

# Build l'application pour production
RUN npm run build -- --configuration production

# Runtime stage
FROM nginx:alpine

# Copier la configuration Nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx-default.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers build (Vérifier le nom du dossier dans dist)
COPY --from=builder /app/dist/FrontEnd_Timora/browser /usr/share/nginx/html

# Créer les dossiers de logs
RUN mkdir -p /var/log/nginx

# Exposer le port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/index.html || exit 1

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
